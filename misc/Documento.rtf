\par
  metadata?: Record<string, any>\par
\}\par
Transform Structure\par
class Transform \{\par
  position: Vector3\par
  rotation: Quaternion\par
  scale: Vector3\par
\par
  matrix: Matrix4\par
  worldMatrix: Matrix4\par
\}\par
